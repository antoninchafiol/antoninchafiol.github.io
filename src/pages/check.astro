---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";

const projects = [
  {
    number: "01",
    title: "DICOM De-identification CLI",
    description:
      "Rust CLI that strips patient data from CT scans. Built for speed and safety.",
    metric: "516 CTs · 1.3s",
    stack: ["Rust", "DICOM"],
    link: "https://github.com/",
  },
  {
    number: "02",
    title: "Life Ops Pipeline",
    description:
      "Event-driven ingestion for email and documents: classify, extract, store, search. Dry-run first, automation earned.",
    metric: "in progress",
    stack: ["Python", "Postgres", "IaC"],
    link: "https://github.com/",
  },
  {
    number: "03",
    title: "Next Project",
    description: "Replace me with something that has a number worth showing.",
    metric: "-- ms",
    stack: ["Rust", "C"],
    link: "https://github.com/",
  },
];

const now = [
  { label: "Building", text: "A careful, reversible pipeline for my own email and documents." },
  { label: "Learning", text: "More Rust: async, error design, and making failure modes boring." },
  { label: "Playing", text: "Guitar (badly, happily) and the odd Factorio factory." },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Backend & DevOps engineer building fast, careful systems in Rust and Python."
    />
    <meta name="theme-color" content="#0f0c0d" />
    <title>Your Name — Backend & DevOps Engineer</title>
  </head>

  <body>
    <header class="navbar">
      <a class="logo" href="/">yourname<span>.</span></a>

      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#now">Now</a>
        <a href="#about">About</a>
        <a class="contact-link" href="mailto:hello@example.com">
          Let's talk <span>↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="availability">
          <span class="status-dot"></span>
          Open to roles
        </div>

        <h1>
          I build fast,<br />
          <span class="accent">careful</span> <span class="muted">systems.</span>
        </h1>

        <p class="intro">
          Backend &amp; DevOps engineer. I started in C/C++ and security, and I
          like understanding how things break so I can build them to last.
          Rust and Python these days.
        </p>

        <div class="terminal" role="img" aria-label="Terminal output: 516 files processed in 1.3 seconds">
          <span class="prompt">$</span> cargo run --release -- ./scans<br />
          <span class="out">✓ 516 files de-identified · 1.3s</span>
        </div>

        <div class="hero-actions">
          <a class="primary-button" href="#work">
            See my work <span>↓</span>
          </a>
          <a class="secondary-button" href="mailto:hello@example.com">
            Get in touch ↗
          </a>
        </div>

        <div class="hero-bottom">
          <span>BASED IN YOUR CITY</span>
          <span>RUST · PYTHON · C/C++ · LINUX</span>
        </div>
      </section>

      <section id="work" class="work section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / SELECTED WORK</p>
            <h2>Things I've built<span>.</span></h2>
          </div>
          <p class="section-note">Each one has a write-up: problem, constraints, design, result.</p>
        </div>

        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-preview">
                <span class="project-number">{project.number}</span>
                <span class="metric">{project.metric}</span>
              </div>

              <div class="project-info">
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                </div>

                <a
                  class="project-link"
                  href={project.link}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`View ${project.title}`}
                >
                  ↗
                </a>
              </div>

              <div class="tags">
                {project.stack.map((tech) => <span>{tech}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="now" class="now section">
        <p class="eyebrow">02 / NOW</p>
        <h2>What I'm up to<span>.</span></h2>
        <dl class="now-list">
          {now.map((item) => (
            <div class="now-row">
              <dt>{item.label}</dt>
              <dd>{item.text}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section id="about" class="about section">
        <p class="eyebrow">03 / ABOUT</p>
        <h2>
          Curious by nature.<br />
          <span class="muted">Careful by habit.</span>
        </h2>
        <p class="about-copy">
          I love optimizing things, but carefully: reversible changes, dry
          runs, logs for everything. I don't have one narrow specialty. I like
          learning whatever a robust system needs, from low-level code to
          infrastructure. Years of Factorio and EVE taught me to think in
          pipelines and bottlenecks, and I haven't stopped.
        </p>
        <a class="text-link" href="mailto:hello@example.com">
          Say hello ↗
        </a>
      </section>
    </main>

    <footer>
      <a class="logo" href="/">yourname<span>.</span></a>
      <p>Designed &amp; built with Astro.</p>
      <a href="#top" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">
        Back to top ↑
      </a>
    </footer>
  </body>
</html>

<style>
  :global(:root) {
    --bg: #0f0c0d;
    --surface: #171214;
    --border: #2a2023;
    --text: #f2ecec;
    --muted: #8a7d80;
    --body: #b3a6a9;
    --accent: #8c2a4a;        /* bordeaux: fills only, with light text */
    --accent-hover: #a33559;
    --accent-text: #d98aa3;   /* claret tint: text and thin accents */
    --ok: #6fcf97;            /* status only */
    --mono: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, monospace;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  :global(body) {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a:focus-visible) {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .navbar {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8%;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    font-size: 1.2rem;
    font-weight: 750;
    letter-spacing: -0.06em;
  }

  .logo span,
  h2 > span:not(.muted),
  .accent {
    color: var(--accent-text);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  nav a:hover,
  footer a:hover {
    color: var(--accent-text);
  }

  nav .contact-link {
    color: var(--text);
    border: 1px solid var(--border);
    padding: 10px 15px;
    border-radius: 5px;
  }

  nav .contact-link:hover {
    border-color: var(--accent);
    background: rgba(140, 42, 74, 0.18);
  }

  .hero {
    position: relative;
    min-height: 640px;
    max-width: 1250px;
    margin: auto;
    padding: 110px 8% 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* faint blueprint grid + bordeaux glow */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse at 85% 20%, rgba(140, 42, 74, 0.28), transparent 55%),
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 56px 56px;
    opacity: 0.55;
    mask-image: radial-gradient(ellipse at 70% 30%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 70% 30%, #000 0%, transparent 70%);
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--body);
    padding: 8px 12px;
    border-radius: 100px;
    font-family: var(--mono);
    font-size: 0.74rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background: var(--ok);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--ok);
  }

  h1 {
    margin: 32px 0 20px;
    font-size: clamp(3.4rem, 9vw, 7.5rem);
    line-height: 1;
    letter-spacing: -0.075em;
    font-weight: 650;
  }

  .muted {
    color: var(--muted);
  }

  .intro {
    max-width: 520px;
    color: var(--body);
    line-height: 1.8;
    font-size: 1rem;
  }

  .terminal {
    margin-top: 8px;
    padding: 14px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--body);
  }

  .terminal .prompt {
    color: var(--accent-text);
  }

  .terminal .out {
    color: var(--ok);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 28px;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 14px 18px;
    background: var(--accent);
    color: var(--text);
    border-radius: 5px;
    font-size: 0.88rem;
    font-weight: 650;
    transition: transform 0.2s, background 0.2s;
  }

  .primary-button:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .secondary-button {
    color: var(--body);
    font-size: 0.88rem;
  }

  .secondary-button:hover {
    color: var(--accent-text);
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-top: auto;
    padding-top: 75px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
  }

  .section {
    max-width: 1250px;
    margin: auto;
    padding: 100px 8%;
  }

  .work,
  .now,
  .about {
    border-top: 1px solid var(--border);
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 38px;
  }

  .eyebrow {
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  h2 {
    margin: 15px 0 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: -0.06em;
    line-height: 1.1;
  }

  .section-note {
    max-width: 320px;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .project-preview {
    aspect-ratio: 1.25;
    background:
      radial-gradient(ellipse at 75% 30%, rgba(140, 42, 74, 0.42) 0%, transparent 55%),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    transition: border-color 0.25s;
  }

  .project-card:nth-child(2) .project-preview {
    background:
      radial-gradient(ellipse at 25% 75%, rgba(140, 42, 74, 0.36) 0%, transparent 55%),
      var(--surface);
  }

  .project-card:nth-child(3) .project-preview {
    background:
      radial-gradient(ellipse at 70% 80%, rgba(140, 42, 74, 0.3) 0%, transparent 55%),
      var(--surface);
  }

  .project-card:hover .project-preview {
    border-color: var(--accent);
  }

  .project-number {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .metric {
    font-family: var(--mono);
    color: var(--accent-text);
    font-size: 1.15rem;
    font-weight: 500;
  }

  .project-info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
  }

  .project-info h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .project-info p {
    color: var(--body);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .project-link {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border: 1px solid var(--border);
    border-radius: 50%;
    transition: background 0.2s, border-color 0.2s;
  }

  .project-link:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--text);
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 15px;
  }

  .tags span {
    border: 1px solid var(--border);
    color: var(--body);
    padding: 5px 9px;
    font-family: var(--mono);
    font-size: 0.68rem;
    border-radius: 4px;
  }

  .now-list {
    margin: 36px 0 0;
    max-width: 760px;
  }

  .now-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--border);
  }

  .now-row:last-child {
    border-bottom: 1px solid var(--border);
  }

  .now-row dt {
    color: var(--accent-text);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .now-row dd {
    margin: 0;
    color: var(--body);
    line-height: 1.7;
  }

  .about h2 {
    font-size: clamp(2.5rem, 6vw, 5rem);
  }

  .about-copy {
    max-width: 560px;
    margin: 28px 0;
    color: var(--body);
    line-height: 1.9;
  }

  .text-link {
    display: inline-block;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--accent-text);
    color: var(--accent-text);
    font-size: 0.9rem;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 28px 8%;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .project-preview {
      aspect-ratio: 1.8;
    }
  }

  @media (max-width: 760px) {
    .navbar {
      height: 72px;
      padding: 0 6%;
    }

    nav {
      gap: 15px;
    }

    .hero {
      min-height: 600px;
      padding: 90px 6% 30px;
    }

    .section {
      padding: 75px 6%;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .now-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    footer {
      padding: 25px 6%;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 430px) {
    nav {
      gap: 12px;
      font-size: 0.78rem;
    }

    nav .contact-link {
      padding: 8px;
    }

    .hero-bottom {
      font-size: 0.57rem;
      letter-spacing: 0.05em;
      gap: 12px;
    }

    footer p {
      order: 3;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    *, *::before, *::after {
      transition-duration: 0.01ms !important;
    }
  }
</style>