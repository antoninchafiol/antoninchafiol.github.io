---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
const projects = [
  {
    number: "01",
    title: "Project One",
    description: "A web application designed to solve a real-world problem.",
    stack: ["TypeScript", "React"],
    link: "https://github.com/",
  },
  {
    number: "02",
    title: "Project Two",
    description: "A clean, responsive experience built for the modern web.",
    stack: ["Astro", "CSS"],
    link: "https://github.com/",
  },
  {
    number: "03",
    title: "Project Three",
    description: "An experiment exploring creative development and design.",
    stack: ["JavaScript", "API"],
    link: "https://github.com/",
  },
];
---




<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Personal portfolio showcasing my projects, skills and experience."
    />
    <meta name="theme-color" content="#101010" />
    <title>Your Name — Developer Portfolio</title>
  </head>

  <body>
    <header class="navbar">
      <a class="logo" href="/">yourname<span>.</span></a>

      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a class="contact-link" href="mailto:hello@example.com">
          Let's talk <span>↗</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="availability">
          <span class="status-dot"></span>
          Available for opportunities
        </div>

        <h1>
          I build things<br />
          for the <span class="muted">web.</span>
        </h1>

        <p class="intro">
          I'm Your Name, a developer focused on building
          thoughtful digital experiences with clean code and
          purposeful design.
        </p>

        <div class="hero-actions">
          <a class="primary-button" href="#work">
            Explore my work <span>↓</span>
          </a>
          <a class="secondary-button" href="mailto:hello@example.com">
            Get in touch ↗
          </a>
        </div>

        <div class="hero-bottom">
          <span>BASED IN YOUR CITY</span>
          <span>SCROLL TO EXPLORE ↓</span>
        </div>
      </section>

      <section id="work" class="work section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / SELECTED WORK</p>
            <h2>Things I've built<span>.</span></h2>
          </div>
          <p class="section-note">A selection of personal projects.</p>
        </div>

        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <div class="project-preview">
                <span class="project-number">{project.number}</span>
                <span class="preview-mark">✳</span>
              </div>

              <div class="project-info">
                <div>
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                </div>

                <a
                  class="project-link"
                  href={project.link}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`View ${project.title}`}
                >
                  ↗
                </a>
              </div>

              <div class="tags">
                {project.stack.map((tech) => <span>{tech}</span>)}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="about" class="about section">
        <p class="eyebrow">02 / A LITTLE ABOUT ME</p>
        <h2>
          Curious by nature.<br />
          <span class="muted">Developer by choice.</span>
        </h2>
        <p class="about-copy">
          I enjoy turning ideas into useful digital products.
          I'm interested in thoughtful interfaces, performance,
          and the little details that make websites feel great.
        </p>
        <a class="text-link" href="mailto:hello@example.com">
          More about me ↗
        </a>
      </section>
    </main>

    <footer>
      <a class="logo" href="/">yourname<span>.</span></a>
      <p>Designed & built with Astro.</p>
      <a href="#top" onclick="window.scrollTo({top: 0, behavior: 'smooth'}); return false;">
        Back to top ↑
      </a>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }

  :global(body) {
    margin: 0;
    background: #101010;
    color: #f4f1f0;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .navbar {
    height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8%;
    border-bottom: 1px solid #262626;
  }

  .logo {
    font-size: 1.2rem;
    font-weight: 750;
    letter-spacing: -0.06em;
  }

  .logo span,
  h2 > span {
    color: #b76e86;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
    color: #a5a5a5;
    font-size: 0.88rem;
  }

  nav a:hover,
  footer a:hover {
    color: #b9fa78;
  }

  nav .contact-link {
    color: #f1f0eb;
    border: 1px solid #414141;
    padding: 10px 15px;
    border-radius: 5px;
  }

  .hero {
    min-height: 610px;
    max-width: 1250px;
    margin: auto;
    padding: 110px 8% 30px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .availability {
    display: flex;
    align-items: center;
    gap: 9px;
    border: 1px solid #30352b;
    background: #191d17;
    color: #c0c8b8;
    padding: 8px 12px;
    border-radius: 100px;
    font-size: 0.76rem;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background: #b76e86;
    border-radius: 50%;
  }

  h1 {
    margin: 32px 0 20px;
    font-size: clamp(4rem, 10vw, 8.5rem);
    line-height: 0.98;
    letter-spacing: -0.085em;
    font-weight: 650;
  }

  .muted {
    color: #777772;
  }

  .intro {
    max-width: 470px;
    color: #a2a29c;
    line-height: 1.8;
    font-size: 1rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 22px;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 14px 18px;
    background: #741f3d;
    color: #151712;
    border-radius: 5px;
    font-size: 0.88rem;
    font-weight: 650;
    transition: transform 0.2s;
  }

  .primary-button:hover {
    transform: translateY(-2px);
  }

  .secondary-button {
    color: #c6c6c0;
    font-size: 0.88rem;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-top: auto;
    padding-top: 75px;
    color: #777772;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  .section {
    max-width: 1250px;
    margin: auto;
    padding: 100px 8%;
  }

  .work {
    border-top: 1px solid #262626;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 38px;
  }

  .eyebrow {
    color: #a1a19a;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  h2 {
    margin: 15px 0 0;
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: -0.065em;
    line-height: 1.1;
  }

  .section-note {
    color: #898983;
    font-size: 0.85rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .project-preview {
    aspect-ratio: 1.25;
    background:
      radial-gradient(ellipse at 70% 35%, #343c2c 0%, transparent 45%),
      #1b1c19;
    border: 1px solid #30302b;
    border-radius: 6px;
    padding: 18px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    overflow: hidden;
  }

  .project-card:nth-child(2) .project-preview {
    background:
      radial-gradient(ellipse at 30% 75%, #353333 0%, transparent 50%),
      #1b1b1b;
  }

  .project-card:nth-child(3) .project-preview {
    background:
      radial-gradient(ellipse at 70% 30%, #28373b 0%, transparent 50%),
      #191c1d;
  }

  .project-number {
    color: #b9b9b0;
    font-size: 0.75rem;
  }

  .preview-mark {
    color: #741f3d;
    font-size: 2.5rem;
    transition: transform 0.3s;
  }

  .project-card:hover .preview-mark {
    transform: rotate(45deg);
  }

  .project-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
  }

  .project-info h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .project-info p {
    color: #96968f;
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .project-link {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border: 1px solid #383832;
    border-radius: 50%;
  }

  .project-link:hover {
    background: #741f3d;
    color: #101010;
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 15px;
  }

  .tags span {
    border: 1px solid #34342f;
    color: #b0b0a8;
    padding: 5px 9px;
    font-size: 0.7rem;
    border-radius: 4px;
  }

  .about {
    border-top: 1px solid #262626;
  }

  .about h2 {
    font-size: clamp(2.5rem, 6vw, 5rem);
  }

  .about-copy {
    max-width: 520px;
    margin: 28px 0;
    color: #a2a29c;
    line-height: 1.9;
  }

  .text-link {
    display: inline-block;
    padding-bottom: 5px;
    border-bottom: 1px solid #b9fa78;
    color: #b9fa78;
    font-size: 0.9rem;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 28px 8%;
    border-top: 1px solid #262626;
    color: #898983;
    font-size: 0.78rem;
  }

  @media (max-width: 760px) {
    .navbar {
      height: 72px;
      padding: 0 6%;
    }

    nav {
      gap: 15px;
    }

    .hero {
      min-height: 590px;
      padding: 100px 6% 30px;
    }

    .section {
      padding: 75px 6%;
    }

    .project-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .project-preview {
      aspect-ratio: 1.6;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    footer {
      padding: 25px 6%;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 430px) {
    nav {
      gap: 12px;
      font-size: 0.78rem;
    }

    nav .contact-link {
      padding: 8px;
    }

    .hero {
      min-height: 550px;
    }

    .hero-bottom {
      font-size: 0.57rem;
      letter-spacing: 0.06em;
      gap: 12px;
    }

    footer p {
      order: 3;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    *, *::before, *::after {
      transition-duration: 0.01ms !important;
    }
  }
</style>