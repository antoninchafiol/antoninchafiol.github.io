---
import About from '../components/About.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Now from '../components/Now.astro';
import Foot from '../components/Foot.astro';

import Layout from '../layouts/Layout.astro';
import "../styles/global.css";

interface Item {
  period: string;
  title: string;
  org: string;
  summary: string;
  points?: string[];
  stack?: string[];
}
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  items: Item[];
}
const { id, eyebrow, heading, items } = Astro.props;
---

<Layout>
    <Header></Header>

    <main>
      <Hero></Hero>
      <Work></Work>
      <About></About>
        <Now></Now>

    </main>
    <Foot></Foot>
</Layout>

<style>

</style>