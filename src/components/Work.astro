---
const projects = [
  {
    number: "01",
    title: "DICOM De-identification CLI",
    description: "Rust CLI that strips patient data from CT scans. Built for speed and safety.",
    metric: { value: "1.3", unit: "s", label: "516 CTs · 264 MB" },
    stack: ["Rust", "DICOM", "Async"],
    link: "https://github.com/antoninchafiol/pulsedcm",
  },
    {
    number: "02",
    title: "Teachable Machine",
    description: "An education focused version of Learnable Machine by Google, made with C# WASM and Python for cached Deep Learning, both communicating with APIs",
    metric: { value: "2", unit: "classes", label: "image classification" },
    stack: ["Python", "C#", "API", "Async"],
    link: "https://github.com/antoninchafiol",
  },

  {
    number: "03",
    title: "Life Ops Pipeline",
    description: "Event-driven ingestion for email and documents: classify, extract, store, search. Dry-run first, automation earned.",
    metric: { status: "In progress", label: "dry-run first" },    stack: ["Python", "MySQL", "IaC", "Rust"],
    link: "https://github.com/antoninchafiol",
  },

];
const otherWork = [
  {
    title: "SentiNet",
    description: "Sentinel-2 satellite image segmentation using Sentinel Hub.",
    stack: ["Python", "Jupyter", "Segmentation"],
    link: "https://github.com/antoninchafiol/SentiNet",
  },
  {
    title: "ECG Myocardial Infarction",
    description: "Detecting myocardial infarction from ECG readings.",
    stack: ["Python", "Jupyter", "Signals"],
    link: "https://github.com/antoninchafiol/ECG_Myocardial_Infarction",
  },
  {
    title: "NotASecureShell",
    description: "A small SSH-style client/server, built to learn network programming.",
    stack: ["C", "Networking"],
    link: "https://github.com/antoninchafiol/NotASecureShell",
  },
  {
    title: "voac",
    description: "Voice-activated launcher for commands and macros.",
    stack: ["Python", "Automation"],
  },
  {
    title: "anemopile",
    description: "BASIC to Python/C transpiler, parser stage. Built to learn compiler design.",
    stack: ["Rust", "Parsing"],
    link: "https://github.com/antoninchafiol/anemopile",
  },
];
---


<section id="work" class="work section">
    <div class="section-heading">
        <div>
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2>Things I've built<span>.</span></h2>
        </div>
        <p class="section-note">Each one has a write-up: problem, constraints, design, result.</p>
    </div>

    <div class="project-grid">
        {projects.map((project) => (
        <article class="project-card">
            <div class="project-preview">
              <span class="project-number">{project.number}</span>

              <div class="metric">
                {project.metric.status ? (
                  <span class="metric-status"><i></i>{project.metric.status}</span>
                ) : (
                  <span class="metric-value">
                    {project.metric.value}<small>{project.metric.unit}</small>
                  </span>
                )}
                <span class="metric-label">{project.metric.label}</span>
              </div>
            </div>

            <div class="project-info">
            <div>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
            </div>

            <a
                class="project-link"
                href={project.link}
                target="_blank"
                rel="noreferrer"
                aria-label={`View ${project.title}`}
            >
                ↗
            </a>
            </div>

            <div class="tags">
            {project.stack.map((tech) => <span>{tech}</span>)}
            </div>
        </article>
        ))}
    </div>
     <div class="other-work">
        <p class="eyebrow">OTHER WORK</p>
        <div class="other-grid">
            {otherWork.map((item) => (
            <article class="other-card">
                <h4>
                {item.link ? (
                    <a href={item.link} target="_blank" rel="noreferrer">{item.title} ↗</a>
                ) : (
                    <span>{item.title}</span>
                )}
                </h4>
                <p>{item.description}</p>
                <div class="tags">
                {item.stack.map((tech) => <span>{tech}</span>)}
                </div>
            </article>
            ))}
        </div>
    </div>
</section>

<style>
  .other-work {
    margin-top: 64px;
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .other-card {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 16px 18px;
    transition: border-color 0.25s;
  }

  .other-card:hover {
    border-color: var(--accent);
  }

  .other-card h4 {
    margin: 0;
    font-size: 0.92rem;
  }

  .other-card h4 a:hover {
    color: var(--accent-text);
  }

  .other-card p {
    color: var(--body);
    font-size: 0.78rem;
    line-height: 1.6;
    margin: 6px 0 0;
  }

  .other-card .tags {
    margin-top: 12px;
  }
  .work {
    border-top: 1px solid var(--border);
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 38px;
  }

  .section-note {
    max-width: 320px;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .project-preview {
    aspect-ratio: 1.25;
    background:
      radial-gradient(ellipse at 75% 30%, rgba(140, 42, 74, 0.42) 0%, transparent 55%),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    transition: border-color 0.25s;
  }

  .project-card:nth-child(2) .project-preview {
    background:
      radial-gradient(ellipse at 25% 75%, rgba(140, 42, 74, 0.36) 0%, transparent 55%),
      var(--surface);
  }

  .project-card:nth-child(3) .project-preview {
    background:
      radial-gradient(ellipse at 70% 80%, rgba(140, 42, 74, 0.3) 0%, transparent 55%),
      var(--surface);
  }

  .project-card:hover .project-preview {
    border-color: var(--accent);
  }

  .project-number {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .metric-value {
    font-size: clamp(2.6rem, 4.5vw, 3.4rem);
    font-weight: 650;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .metric-value small {
    margin-left: 6px;
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--accent-text);
  }

  .metric-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .metric-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 6px 11px;
    border: 1px solid var(--accent);
    border-radius: 100px;
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--accent-text);
  }

  .metric-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-text);
    animation: blink 1.6s ease-in-out infinite;
  }

  @keyframes blink {
    50% { opacity: 0.25; }
  }

  @media (prefers-reduced-motion: reduce) {
    .metric-status i { animation: none; }
  }

  .project-info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-top: 20px;
  }

  .project-info h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .project-info p {
    color: var(--body);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .project-link {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 35px;
    height: 35px;
    border: 1px solid var(--border);
    border-radius: 50%;
    transition: background 0.2s, border-color 0.2s;
  }

  .project-link:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--text);
  }

  .tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 15px;
  }

  .tags span {
    border: 1px solid var(--border);
    color: var(--body);
    padding: 5px 9px;
    font-family: var(--mono);
    font-size: 0.68rem;
    border-radius: 4px;
  }

  @media (max-width: 900px) {
    .project-grid { grid-template-columns: 1fr; gap: 38px; }
    .project-preview { aspect-ratio: 1.8; }
  }

  @media (max-width: 760px) {
    .section-heading { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>