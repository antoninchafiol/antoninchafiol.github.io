  .pulses path:nth-child(3) { animation-duration: 6s; animation-delay: -1.5s; }

  .nodes circle {
    fill: var(--bg, #0b0b0d);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  @keyframes flow {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses path { animation: none; stroke-dasharray: none; opacity: 0; }
  }


  .availability {
    display: flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--border);
