      radial-gradient(circle, var(--border) 1px, transparent 1.5px) 0 0 / 28px 28px;
    -webkit-mask-image: linear-gradient(to bottom, #000 65%, transparent);
    mask-image: linear-gradient(to bottom, #000 65%, transparent);
  }

  .hero-bg svg {
    width: 100%;
    height: 100%;
    -webkit-mask-image: linear-gradient(to right, transparent 15%, #000 65%);
    mask-image: linear-gradient(to right, transparent 15%, #000 65%);
  }

  .traces path,
  .pulses path {
    fill: none;
    stroke-linejoin: round;
  }

  .traces path {
    stroke: var(--border);
    stroke-width: 1.5;
  }

  .pulses path {
    stroke: var(--accent-text);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 3 97;
    stroke-dashoffset: 100;
    animation: flow 7s linear infinite;
  }

