---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Antonin Chafiol - Reliability Engineer",
  description = "Reliability engineer, working close to databases and data pipelines. I started in C/C++ and security, and I like understanding how things break so I can build them to last. Rust and Python these days.",
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0c0d" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
